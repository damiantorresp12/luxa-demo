# =============================================================================
# LUXA — .gitignore
# =============================================================================

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Helpers temporales generados durante desarrollo
_scroll-preview.html
*.tmp

# Modelos 3ds Max — apuntados desde el catálogo (assets.model) pero no
# renderizables en web. ~540 archivos pesados. Eliminá esta línea si en algún
# momento decidís ofrecerlos como descarga real (mejor: storage aparte).
assets/models/

# Originales de los renders, antes de pasarlos por optimizar-imagenes.ps1.
# Son ~270 MB que nadie descarga: la app usa las copias livianas. Quedan solo
# en la computadora de Damian, como respaldo por si hay que rehacer la
# optimización con otra calidad.
assets/_originales/

# Backups del Space Planner
space-planner/**/*.bak.json
space-planner/**/*.pre-cleanup.bak.json

# Backups locales generados por el Product Data Generator (no van a prod)
data/*.bak.json
